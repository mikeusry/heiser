---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTASection from '../components/CTASection.astro';
import { contact, company } from '../lib/contact';

const title = "Realtor & Real Estate Cleaning Services | Lake County IL | The Heiser Group";
const description = "Realtor and real estate cleaning in Lake County IL: move-out, pre-listing, and tenant turnover cleaning, showing-ready in 48–72 hours. Free walkthrough and honest quote.";

const services = [
	{
		title: "Pre-Listing Cleaning",
		description: "Cleaning a house before selling it pays off in the listing photos. We detail every room so the home is photo-ready and showing-ready.",
		icon: "sparkle" as const
	},
	{
		title: "Move-Out Cleaning",
		description: "Help sellers meet their move-out obligations. We handle the deep clean of the empty house so the closing goes smoothly.",
		icon: "check" as const
	},
	{
		title: "Move-In Ready",
		description: "Make sure buyers walk into a spotless home. A clean start makes for happy clients and great referrals.",
		icon: "star" as const
	},
	{
		title: "Tenant Turnovers",
		description: "Real estate turnover cleaning for landlords and property management companies. Thorough cleaning between tenants to cut vacancy time.",
		icon: "calendar" as const
	}
];

const audiences = [
	{
		title: "Real Estate Agents",
		description: "Realtor cleaning built around your listing and closing dates, with priority scheduling and flexible billing."
	},
	{
		title: "Property Managers",
		description: "Turnover cleaning for property management, with consistent quality across every unit and rental house you manage."
	},
	{
		title: "Homeowners Selling a House",
		description: "Selling or moving? We handle the house cleaning before the sale so you can focus on the move."
	}
];

const whyPartner = [
	{
		title: "Showing-Ready in 48–72 Hours",
		description: "Most homes are showing-ready within 48–72 hours of our walkthrough. Closing date coming up? Realtor partners get priority on our schedule."
	},
	{
		title: "Consistent Quality Every Time",
		description: "Your reputation is on the line. We deliver the same high standards whether it's a condo or a 5,000 sq ft home."
	},
	{
		title: "Flexible Billing Options",
		description: "We can invoice at closing, bill you directly, or bill the homeowner. Whatever works for your deal structure."
	},
	{
		title: "Before & After Documentation",
		description: "Need proof for the seller or buyer? We provide photo documentation of our work for your records."
	}
];

const faqs = [
	{
		question: "What does a real estate cleaning service include?",
		answer: "Real estate cleaning, often called realtor cleaning, is a top-to-bottom clean of a home being listed, sold, or turned over between tenants: kitchens and appliances, bathrooms, floors, baseboards, window sills, and every room detailed for listing photos and showings. The Heiser Group handles pre-listing, move-out, move-in, and tenant turnover cleaning in Lake County, IL."
	},
	{
		question: "Should you clean a house before selling it?",
		answer: "Yes. A clean house photographs better and shows better, and buyers notice grime, odors, and neglected kitchens and bathrooms first. A professional pre-listing clean gets the home showing-ready before photos and the first open house."
	},
	{
		question: "Does the realtor pay for cleaning before a house sale?",
		answer: "It depends on the deal. The seller usually pays for cleaning before listing or after moving out, and some agents cover it for their clients. We can bill the agent, bill the homeowner, or invoice at closing."
	},
	{
		question: "How fast can you get a property showing-ready?",
		answer: "Most properties are showing-ready within 48–72 hours of our walkthrough. Realtor partners get priority scheduling when a listing or closing deadline is tight."
	},
	{
		question: "Do you offer volume pricing for realtors and property managers?",
		answer: "Yes. Real estate agents and property management companies who send us regular work get priority scheduling and preferred rates. Ask about our Realtor Partner Program."
	},
	{
		question: "What if the property is in really bad shape?",
		answer: "Neglected rentals and heavy move-out cleans are routine for us. Our Highland Park turnover took a neglected rental to showing-ready in 24 hours. Tell us what you're dealing with and we'll walk through it and give you an honest quote."
	},
	{
		question: "What areas do you serve?",
		answer: "Lake County IL, the Chicago North Shore, and Kenosha WI, including Buffalo Grove, Highland Park, Lake Forest, Libertyville, Northbrook, Vernon Hills, Gurnee, and surrounding areas."
	}
];

// Schema markup
const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map(faq => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answer
		}
	}))
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"name": "Realtor & Real Estate Cleaning",
	"description": "Real estate cleaning for realtors, property managers, and homeowners selling a house in Lake County IL: pre-listing, move-out, move-in, and tenant turnover cleaning.",
	"provider": {
		"@type": "LocalBusiness",
		"@id": "https://heisergroup.com/#localbusiness",
		"name": company.name,
		"telephone": contact.phone.display,
		"address": {
			"@type": "PostalAddress",
			"streetAddress": contact.address.street,
			"addressLocality": contact.address.city,
			"addressRegion": contact.address.state,
			"postalCode": contact.address.zip,
			"addressCountry": "US"
		}
	},
	"areaServed": [
		{ "@type": "County", "name": "Lake County", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Buffalo Grove", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Highland Park", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Lake Forest", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Libertyville", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Northbrook", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Vernon Hills", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Gurnee", "containedIn": "Illinois" },
		{ "@type": "City", "name": "Kenosha", "containedIn": "Wisconsin" }
	],
	"serviceType": ["Real Estate Cleaning", "Pre-Listing Cleaning", "Move-Out Cleaning", "Move-In Cleaning", "Tenant Turnover Cleaning"]
};
---

<BaseLayout title={title} description={description}>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

	<PageHero
		eyebrow="REALTOR & REAL ESTATE CLEANING"
		title="Same-Week Turnovers. Showing-Ready Homes."
		subtitle="A reliable real estate cleaning partner for realtors, property managers, and homeowners, for the deadlines that don't move."
	/>

	<!-- Who We Serve -->
	<section class="py-20 bg-white">
		<div class="max-w-6xl mx-auto px-6">
			<SectionHeader title="Who We Serve" />
			<div class="grid md:grid-cols-3 gap-8">
				{audiences.map(audience => (
					<div class="text-center p-8 bg-gray-50 rounded-xl">
						<h3 class="text-2xl font-heading font-bold text-brand-navy mb-4">{audience.title}</h3>
						<p class="text-gray-600">{audience.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Services Grid -->
	<section class="py-20 bg-brand-cream">
		<div class="max-w-6xl mx-auto px-6">
			<SectionHeader
				title="Our Real Estate Cleaning Services"
				subtitle="From pre-listing prep to post-closing turnovers"
			/>
			<div class="grid md:grid-cols-2 gap-8">
				{services.map(service => (
					<div class="bg-white p-8 rounded-xl shadow-lg">
						<FeatureCard
							title={service.title}
							description={service.description}
							icon={service.icon}
							iconSize="lg"
						/>
					</div>
				))}
			</div>
			<p class="text-center text-gray-700 mt-10 max-w-3xl mx-auto">
				Need more than a turnover? Pair it with a <a href="/one-time-deep-clean/" class="text-brand-orange font-semibold hover:underline">one-time deep clean</a> for post-construction or a seasonal reset, or add <a href="/specialty-cleaning/" class="text-brand-orange font-semibold hover:underline">carpet shampooing, tile, and hardwood floor care</a>.
			</p>
		</div>
	</section>

	<!-- Why Partner Section -->
	<section class="py-20 bg-white">
		<div class="max-w-6xl mx-auto px-6">
			<div class="max-w-3xl mx-auto text-center mb-12">
				<h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-navy mb-4">
					A Cleaning Partner, Not Just a Vendor
				</h2>
				<p class="text-xl text-gray-600">
					You've built a network of reliable vendors—photographers, stagers, inspectors. We're the cleaning company for real estate agents who need the house clean before the photographer arrives. One call, one less thing to coordinate.
				</p>
			</div>

			<div class="grid md:grid-cols-2 gap-8">
				{whyPartner.map((item, index) => (
					<FeatureCard
						title={item.title}
						description={item.description}
						variant="numbered"
						number={index + 1}
						iconSize="lg"
					/>
				))}
			</div>
		</div>
	</section>

	<!-- Case Study Feature -->
	<section class="py-20 bg-gray-50">
		<div class="max-w-6xl mx-auto px-6">
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div>
					<p class="text-brand-orange font-semibold mb-2 uppercase tracking-wide text-sm">Case Study</p>
					<h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-navy mb-4">
						The Highland Park Turnover
					</h2>
					<p class="text-xl text-gray-600 mb-6">
						How we transformed a neglected rental into a show-ready listing in under 24 hours.
					</p>
					<div class="grid grid-cols-2 gap-4 mb-8">
						<div class="bg-white p-4 rounded-lg">
							<p class="text-2xl font-bold text-brand-orange">24 hrs</p>
							<p class="text-sm text-gray-500">Neglected to showing-ready</p>
						</div>
						<div class="bg-white p-4 rounded-lg">
							<p class="text-2xl font-bold text-brand-orange">3-person</p>
							<p class="text-sm text-gray-500">On-site crew</p>
						</div>
					</div>
					<a href="/case-studies/highland-park-turnover" class="inline-flex items-center gap-2 text-brand-orange font-semibold hover:underline">
						Read the full case study
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div class="relative rounded-lg overflow-hidden shadow-lg">
						<img
							src="https://res.cloudinary.com/southland-organics/image/upload/w_400,h_400,c_fill,q_auto,f_auto/Heiser/Realty%20Rachel/Job%2011.12/Befores/oven"
							alt="Oven before cleaning"
							class="w-full aspect-square object-cover"
							loading="lazy"
						/>
						<span class="absolute top-2 left-2 bg-red-500 text-white px-2 py-1 rounded text-xs font-semibold">Before</span>
					</div>
					<div class="relative rounded-lg overflow-hidden shadow-lg">
						<img
							src="https://res.cloudinary.com/southland-organics/image/upload/w_400,h_400,c_fill,q_auto,f_auto/Heiser/Realty%20Rachel/Job%2011.12/Afters/oven"
							alt="Oven after cleaning"
							class="w-full aspect-square object-cover"
							loading="lazy"
						/>
						<span class="absolute top-2 left-2 bg-green-500 text-white px-2 py-1 rounded text-xs font-semibold">After</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Stats/Social Proof -->
	<section class="py-20 bg-brand-navy text-white">
		<div class="max-w-6xl mx-auto px-6">
			<div class="grid md:grid-cols-3 gap-8 text-center">
				<div>
					<p class="text-5xl font-bold text-brand-orange mb-2">{company.founded}</p>
					<p class="text-xl">Family-Owned Since</p>
				</div>
				<div>
					<p class="text-5xl font-bold text-brand-orange mb-2">3</p>
					<p class="text-xl">Generations of Heisers</p>
				</div>
				<div>
					<p class="text-5xl font-bold text-brand-orange mb-2">48–72hr</p>
					<p class="text-xl">To Showing-Ready</p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="py-20 bg-white">
		<div class="max-w-4xl mx-auto px-6">
			<SectionHeader title="Common Questions" />
			<div class="space-y-6">
				{faqs.map(faq => (
					<div class="border-b border-gray-200 pb-6">
						<h3 class="text-xl font-heading font-bold text-brand-navy mb-2">{faq.question}</h3>
						<p class="text-gray-600">{faq.answer}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Realtor Partner CTA -->
	<section class="py-20 bg-brand-cream">
		<div class="max-w-4xl mx-auto px-6 text-center">
			<h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-navy mb-4">
				Realtor Partner Program
			</h2>
			<p class="text-xl text-gray-600 mb-6 max-w-2xl mx-auto">
				Skip the scheduling headaches. Partners get:
			</p>
			<ul class="text-left max-w-md mx-auto mb-8 space-y-2 text-gray-700">
				<li class="flex items-center gap-2">
					<svg class="w-5 h-5 text-brand-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
					<span><strong>Direct text line</strong> to David—skip the phone tag</span>
				</li>
				<li class="flex items-center gap-2">
					<svg class="w-5 h-5 text-brand-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
					<span><strong>Priority scheduling</strong> for listing and closing deadlines</span>
				</li>
				<li class="flex items-center gap-2">
					<svg class="w-5 h-5 text-brand-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
					<span><strong>Preferred rates</strong> for repeat business</span>
				</li>
				<li class="flex items-center gap-2">
					<svg class="w-5 h-5 text-brand-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
					<span><strong>Flexible billing</strong>—at closing, to you, or to client</span>
				</li>
			</ul>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href="/contact"
					class="inline-block bg-brand-orange text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-brand-orange-dark transition-all duration-300 hover:shadow-xl"
				>
					Become a Partner
				</a>
				<a href={contact.phone.href} class="flex items-center gap-2 font-semibold text-brand-navy hover:text-brand-orange transition-colors text-lg">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
					</svg>
					{contact.phone.display}
				</a>
			</div>
		</div>
	</section>

	<!-- Final CTA -->
	<CTASection
		title="Free Walkthrough. Honest Quote."
		subtitle="No pressure, no sales pitch. We look at the property, listen to what you need, and give you a real number."
		buttonText="Book a Free Walkthrough"
		buttonLink="/contact"
	/>
</BaseLayout>
